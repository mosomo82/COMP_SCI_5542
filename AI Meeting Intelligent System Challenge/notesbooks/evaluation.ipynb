# ── Cell 4: Noisy vs Clean Audio ──────────────────────────────────────────────
"""
Test robustness by adding noise to a clean recording.
Uses librosa to inject white noise at different SNR levels.
"""
import numpy as np
import soundfile as sf
import librosa

def add_noise(audio_path: str, snr_db: float, out_path: str) -> str:
    """Add white noise at given signal-to-noise ratio."""
    audio, sr = librosa.load(audio_path, sr=None)
    signal_power = np.mean(audio ** 2)
    noise_power  = signal_power / (10 ** (snr_db / 10))
    noise = np.random.normal(0, np.sqrt(noise_power), len(audio))
    noisy = audio + noise
    sf.write(out_path, noisy, sr)
    return out_path

# Generate noisy versions
noisy_paths = {}
for snr in [30, 15, 5]:  # 30=mild noise, 5=heavy noise
    path = f"../audio_samples/noisy_snr{snr}.wav"
    add_noise(AUDIO_FILE, snr_db=snr, out_path=path)
    noisy_paths[snr] = path

# Transcribe each
print("\nNoise robustness test:")
for snr, path in noisy_paths.items():
    result = transcribe(path, model_size="small")
    wer = word_error_rate(REFERENCE_TRANSCRIPT, result["text"])
    print(f"SNR {snr:2d} dB | WER: {wer:.2%}")

